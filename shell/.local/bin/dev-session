#!/bin/bash
# dev-session: Create or attach to a tmux dev workspace
# Layout: nvim | terminal | ssh to dev box
#
# Usage: dev-session [session-name]

SESSION="${1:-dev}"
DEV_HOST="ajaiswal@yow-ajaiswal-lx2.corp.ad.wrs.com"
WORKSPACE="$HOME/workspace"

# If session exists, just attach
if tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux attach-session -t "$SESSION"
    exit 0
fi

# Create new session with nvim in first window
tmux new-session -d -s "$SESSION" -n "editor" -c "$WORKSPACE"
tmux send-keys -t "$SESSION:editor" "nvim" Enter

# Window 2: terminal for commands
tmux new-window -t "$SESSION" -n "term" -c "$WORKSPACE"

# Window 3: SSH to dev box
tmux new-window -t "$SESSION" -n "dev-ssh"
tmux send-keys -t "$SESSION:dev-ssh" "ssh $DEV_HOST" Enter

# Focus on editor window
tmux select-window -t "$SESSION:editor"

# Attach
tmux attach-session -t "$SESSION"
