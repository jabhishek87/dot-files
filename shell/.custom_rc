# ~/.custom_rc — portable shell config
# Source this from any system's .bashrc: [ -f ~/.custom_rc ] && . ~/.custom_rc

# ==============================================================================
# HISTORY & SHELL OPTIONS
# ==============================================================================
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend checkwinsize cdspell autocd 2>/dev/null

# ==============================================================================
# PATH
# ==============================================================================
export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$PATH"
export EDITOR=vim

# ==============================================================================
# PROMPT: (venv) hostname:path ✓/✗
# ==============================================================================
__build_ps1() {
    local ex=$?
    local cyan='\[\e[36m\]' green='\[\e[32m\]' yellow='\[\e[33m\]' red='\[\e[31m\]' gray='\[\e[38;5;245m\]' reset='\[\e[0m\]'
    local status venv="" branch=""
    [ $ex -eq 0 ] && status="${green}✓" || status="${red}✗"
    [ -n "$VIRTUAL_ENV" ] && venv="${gray}($(basename "$VIRTUAL_ENV")) ${reset}"
    local gdir h
    gdir="$(git rev-parse --git-dir 2>/dev/null)" || true
    [ -n "$gdir" ] && h="$(cat "$gdir/HEAD" 2>/dev/null)" && case $h in ref:*) branch=" ${yellow}(${h##*/})${reset}";; *) branch=" ${yellow}(${h:0:7})${reset}";; esac
    PS1="${venv}${cyan}\h${reset}:${green}\w${reset}${branch} ${status}${reset} "
}
PROMPT_COMMAND=__build_ps1

# ==============================================================================
# COMPLETIONS
# ==============================================================================
# Override tilde completion — NIS/getent hangs on this system (25K+ users, unresponsive)
_backup_comp_wordbreaks="$COMP_WORDBREAKS"
COMP_WORDBREAKS="${COMP_WORDBREAKS//\~/}"

if ! shopt -oq posix 2>/dev/null; then
    [ -f /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion
    [ -f /etc/bash_completion ] && . /etc/bash_completion
fi
command -v kubectl &>/dev/null && source <(kubectl completion bash 2>/dev/null)

# ==============================================================================
# ALIASES
# ==============================================================================
alias ls='ls --color=auto'
alias ll='ls -alF'
alias la='ls -A'
alias grep='grep --color=auto'
alias k='kubectl'
alias kc='kubectl create'
alias gpush='git push origin HEAD:refs/for/master'
alias vpn_login='globalprotect connect --portal ://gpcloudservice.com'
export dry='--dry-run=client -o yaml'

# ==============================================================================
# FZF + ZOXIDE (smart directory jump: z <partial_path>)
# ==============================================================================
[ -f ~/.fzf.bash ] && . ~/.fzf.bash
command -v zoxide &>/dev/null && eval "$(zoxide init bash)"

# ==============================================================================
# EXTERNAL CONFIGS
# ==============================================================================
[ -f ~/.secret_rc ] && . ~/.secret_rc
[ -f ~/.work_ssh_rc ] && . ~/.work_ssh_rc
